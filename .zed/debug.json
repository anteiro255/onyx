// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
	{
		"label": "Run",
		"mode": "exec",
		"adapter": "CodeLLDB",
		"request": "launch",
		"program": "./target/debug/onyx",
		"args": [],
		"preLaunchTask": "cargo build",
	},
	{
		"adapter": "CodeLLDB",
		"label": "cargo test -p onyx --all-targets",
		"build": {
			"label": "cargo test -p onyx --all-targets",
			"command": "cargo",
			"args": ["test", "--package", "onyx", "--all-targets", "--no-run"],
			"env": {
				"RUSTC_TOOLCHAIN": "/home/user/.rustup/toolchains/stable-x86_64-unknown-linux-gnu",
			},
			"cwd": "/home/user/Projects/onyx",
			"use_new_terminal": false,
			"allow_concurrent_runs": false,
			"reveal": "always",
			"reveal_target": "dock",
			"hide": "never",
			"tags": [],
			"shell": "system",
			"show_summary": false,
			"show_command": false,
			"save": "none",
			"hooks": [],
		},
		"sourceLanguages": ["rust"],
	},
]
